{
  "name": "codejson-crosswalk",
  "module": "src/index.ts",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "codejson-crosswalk": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/index.ts src/cli.ts --outdir dist --target node",
    "docs": "typedoc",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "files": ["dist"],
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typedoc": "^0.28.19",
    "typescript-eslint": "^8.60.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
